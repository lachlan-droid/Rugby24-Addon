PORT=7000
HOST=0.0.0.0
# Set this to a long random value before exposing the add-on outside your Mac.
ADDON_TOKEN=replace-with-a-long-random-token
RUGBY24_BASE_URL=https://rugby24.net/
PAGE_SIZE=20
CACHE_TTL_SECONDS=300
# external = open the original source page (recommended default)
# direct = also return an explicit signed HLS URL when the page exposes one
STREAM_MODE=external
# curl is recommended for this source because Node fetch may be challenged by Cloudflare.
FETCH_MODE=curl
# Local first-page trial settings. These are also safe defaults for a manual refresh.
STATIC_PORT=7100
MAX_SOURCE_PAGES=1
MAX_ITEMS=20
MAX_AGE_DAYS=180
USE_FIRECRAWL=false
ALLOW_PUBLISHED_FALLBACK=false
# The public demo key is suitable for a small trial. Replace it with your own key if available.
SPORTSDB_API_KEY=123
SPORTSDB_MIN_INTERVAL_MS=2500
# Keep all Rugby catalogue rows; only trial SportsDB thumbnails for this competition.
SPORTSDB_COMPETITION_FILTER=
SPORTSDB_THUMBNAIL_FILTER=
